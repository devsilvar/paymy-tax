{
  "name": "paymytax-api",
  "version": "1.0.0",
  "description": "PayMyTax by WallX — SME Tax Calculation, Reporting & Remittance API",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc && tsc-alias",
    "postinstall": "prisma generate",
    "start": "prisma migrate deploy && node dist/server.js",
    "start:no-migrate": "node dist/server.js",
    "start:migrate": "prisma migrate deploy && node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:reset": "prisma migrate reset --force",
    "db:setup": "npm run prisma:generate && npm run prisma:migrate && npm run prisma:seed",
    "test:setup": "tsx src/test-setup.ts",
    "test": "jest --config jest.config.ts",
    "test:unit": "jest --config jest.config.ts tests/unit",
    "test:integration": "jest --config jest.config.ts tests/integration --runInBand",
    "test:e2e": "jest --config jest.config.ts tests/e2e --runInBand --forceExit --testTimeout=30000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "tax",
    "firs",
    "sme",
    "wallx",
    "fintech"
  ],
  "author": "WallX",
  "license": "PRIVATE",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0",
    "@aws-sdk/s3-request-presigner": "^3.1014.0",
    "@ngrok/ngrok": "^1.7.0",
    "@prisma/client": "^6.0.1",
    "@sentry/node": "^10.57.0",
    "@supabase/supabase-js": "^2.100.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.18.0",
    "resend": "^6.12.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.5",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "axios": "^1.19.0",
    "eslint": "^9.19.0",
    "jest": "^30.3.0",
    "prettier": "^3.4.2",
    "prisma": "^6.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
