{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noEmit": true,
    "types": [
      "jest",
      "node"
    ],
    "rootDir": "./src",
    "outDir": "../dist-tests",
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
   "src/**/*"
  ],
  "exclude": [
    "tests",
    "**/*.test.ts"
  ]
}