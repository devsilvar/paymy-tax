# =================================
# APPLICATION CONFIGURATION
# =================================
NODE_ENV=development
PORT=3000
API_VERSION=v1

# =================================
# DATABASE (Neon / Supabase / Render Postgres)
# =================================
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql://postgres.yohizqldizehbwtnjznl:wallx2026liveTUBYUXD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
# Optional — direct (non-pooled) connection for migrations. Required by Neon
# pooled connections; not needed for Render Postgres.
# DIRECT_URL=postgresql://user:password@your-neon-host.neon.tech/paymytax?sslmode=require

# =================================
# JWT AUTHENTICATION
# =================================
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# =================================
# FRONTEND URL (CORS)
# =================================
# Single URL in dev. In production, supply a COMMA-SEPARATED LIST of origins:
#   FRONTEND_URL=https://app.paymytax.ng,https://www.paymytax.ng
FRONTEND_URL=http://localhost:5173

# Production Frontends (comma-separated for Render deployment)
# FRONTEND_URL=https://paymytax.vercel.app,https://paymytax-frontend.onrender.com

# Public-facing API base used in outbound links (emails, WhatsApp messages).
# Defaults to FRONTEND_URL if unset. In prod set to https://api.paymytax.ng.
# PUBLIC_API_URL=https://api.paymytax.ng

# =================================
# REDIS (Upstash) — optional
# =================================
# Get from: https://console.upstash.com
# REDIS_URL=redis://default:password@your-upstash-url.upstash.io:6379

# =================================
# PAYSTACK PAYMENT GATEWAY
# =================================
# Get from: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Paystack webhook signature verification uses HMAC-SHA512 signed with your
# SECRET KEY (unlike Stripe which has a separate webhook secret). So for Paystack:
# PAYSTACK_WEBHOOK_SECRET should equal PAYSTACK_SECRET_KEY (sk_test_* or sk_live_*).
# The previous warning about sk_* being "wrong" was incorrect and has been removed.
PAYSTACK_WEBHOOK_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DVA-creation bank slug. Optional — auto-detected from SECRET_KEY prefix:
#   sk_test_*  → test-bank   (only slug Paystack accepts in test mode)
#   sk_live_*  → wema-bank   (default live partner)
# Set explicitly only if you need a different live bank (e.g. titan-paystack).
# PAYSTACK_PREFERRED_BANK=wema-bank
# DEV/TEST-ONLY: fall back to a local fixture when Paystack name-enquiry
# (/bank/resolve) or subaccount creation fails — lets you exercise the
# settlement-connect flow locally without real bank resolution.
# NEVER set this in production. Fixture also auto-fires when NODE_ENV=test.
# PAYSTACK_MOCK_BANK_RESOLUTION=true

# =================================
# FILE STORAGE (DigitalOcean Spaces / S3) — optional
# =================================
# Get from: https://cloud.digitalocean.com/spaces
# DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# DO_SPACES_REGION=nyc3
# DO_SPACES_BUCKET=paymytax-documents
# DO_SPACES_ACCESS_KEY=your-spaces-access-key
# DO_SPACES_SECRET_KEY=your-spaces-secret-key
# DO_SPACES_CDN_ENDPOINT=https://paymytax-documents.nyc3.cdn.digitaloceanspaces.com

# =================================
# CLOUDINARY — image uploads (logos, receipts)
# =================================
# Get from: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret


# =================================
# EMAIL SERVICE (Resend) — optional
# =================================
# Get from: https://resend.com/api-keys
# When unset, emails are logged to Winston (dev fallback) and meta.delivered=false
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=PayMyTax <noreply@paymytax.ng>

# =================================
# SMS SERVICE (Termii) — optional
# =================================
# Get from: https://termii.com
# TERMII_API_KEY=TLxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TERMII_SENDER_ID=PayMyTax

# =================================
# SUPABASE — optional (only if using Supabase Storage/Auth helpers)
# =================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =================================
# MONITORING & LOGGING
# =================================
# Get from: https://sentry.io
# SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx
LOG_LEVEL=info
# Set to `true` ONLY on hosts with persistent disk (VMs / bare-metal).
# Render / Heroku / Fly have ephemeral disks — leave unset; logs go to stdout.
# ENABLE_FILE_LOGS=true

# =================================
# RATE LIMITING
# =================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =================================
# SCHEDULED JOBS (node-cron)
# =================================
# Auto-true in production. Set true in dev to test the daily 00:30
# Africa/Lagos reminder sweep (otherwise tsx watch re-registers on
# every file save and spams logs).
# ENABLE_CRON=true

# =================================
# TAX (defaults are FIRS-compliant)
# =================================
# TAX_DEFAULT_RATE=7.5
# TAX_MIN_RATE=0
# TAX_MAX_RATE=50
# TAX_CURRENCY=NGN
# TAX_AUTHORITY=FIRS

# =================================
# PIN SECURITY & SETTLEMENT
# =================================
# PIN_MAX_ATTEMPTS=5
# PIN_ATTEMPT_WINDOW_HOURS=24
# SETTLEMENT_MIN_TAX_SPLIT_PCT=7.5
# SETTLEMENT_MAX_TAX_SPLIT_PCT=50
# PLATFORM_COMMISSION_PCT=0

