# Dependencies
node_modules/

# Environment variables — never commit secrets
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.example

# Build output
dist/
build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing
coverage/
.nyc_output/

# Prisma
prisma/.env

# Temp files
tmp/
temp/
*.tmp

# Executables
*.exe
*.dll
*.so
*.dylib

# =================================
# NOTE: package-lock.json IS tracked.
# `npm ci` on Render/CI requires it. Do not add it back to this ignore list.
# Same for prisma/seed.ts and *.md — they belong in source control.
# =================================
