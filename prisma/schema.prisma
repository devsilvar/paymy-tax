generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// User accounts - business owners and administrators
model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  passwordHash        String     @map("password_hash")
  phone               String?    @unique
  bvn                 String?    @map("bvn") @db.VarChar(11)
  nin                 String?    @map("nin") @db.VarChar(11)
  bvnVerifiedAt       DateTime?  @map("bvn_verified_at")
  ninVerifiedAt       DateTime?  @map("nin_verified_at")
  isVerified          Boolean    @default(false) @map("is_verified")
  isActive            Boolean    @default(true) @map("is_active")
  lastLoginAt         DateTime?  @map("last_login_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  resetTokenExpiresAt DateTime?  @map("reset_token_expires_at")
  resetTokenHash      String?    @map("reset_token_hash")
  role                UserRole   @default(user)
  auditLogs           AuditLog[]
  businesses          Business[]

  @@index([email])
  @@index([phone])
  @@index([bvn])
  @@map("users")
}

/// Business profiles - each user can have multiple businesses
model Business {
  id                   String             @id @default(uuid())
  userId               String             @map("user_id")
  businessName         String             @map("business_name")
  ownerName            String             @map("owner_name")
  taxId                String?            @unique @map("tax_id")
  businessType         String?            @map("business_type")
  address              String?
  city                 String?
  state                String?
  paystackCustomerCode String?            @map("paystack_customer_code")
  virtualAccountNumber String?            @map("virtual_account_number")
  virtualAccountBank   String?            @map("virtual_account_bank")
  defaultProfitMargin     Decimal   @default(20.00) @map("default_profit_margin") @db.Decimal(5, 2)
  taxReminderDay          Int       @default(25) @map("tax_reminder_day")
  paystackSubaccountCode  String?   @map("paystack_subaccount_code")
  settlementBankCode      String?   @map("settlement_bank_code")
  settlementBankName      String?   @map("settlement_bank_name")
  settlementAccountNumber String?   @map("settlement_account_number")
  settlementAccountName   String?   @map("settlement_account_name")
  platformCommissionPct   Decimal   @default(0.00) @map("platform_commission_pct") @db.Decimal(5, 2)
  settlementConnectedAt   DateTime? @map("settlement_connected_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  merchantId              String    @unique @map("merchant_id")
  auditLogs            AuditLog[]
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  customers            Customer[]
  expenses             Expense[]
  invoices             Invoice[]
  taxReports           MonthlyTaxReport[]
  reminders            Reminder[]
  sales                SalesTransaction[]
  payments             TaxPayment[]
  statements           TaxStatement[]

  @@index([userId])
  @@index([taxId])
  @@map("businesses")
}

/// Transaction classifications - defines how different transaction types should be treated
model TransactionClassification {
  id           String              @id @default(uuid())
  name         String              @unique
  category     TransactionCategory
  taxTreatment TaxTreatment        @map("tax_treatment")
  isRevenue    Boolean             @default(false) @map("is_revenue")
  isExpense    Boolean             @default(false) @map("is_expense")
  description  String?
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  transactions SalesTransaction[]

  @@index([category])
  @@index([isActive])
  @@map("transaction_classifications")
}

/// Sales transactions - all revenue entries
model SalesTransaction {
  id                  String                     @id @default(uuid())
  businessId          String                     @map("business_id")
  amount              Decimal                    @db.Decimal(15, 2)
  source              SalesSource
  status              TransactionStatus          @default(confirmed)
  referenceId         String?                    @map("reference_id")
  description         String?
  customerName        String?                    @map("customer_name")
  transactionDate     DateTime                   @map("transaction_date") @db.Date
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  createdBy           String?                    @map("created_by")
  metadata            Json?
  needsVerification   Boolean                    @default(false) @map("needs_verification")
  verifiedAt          DateTime?                  @map("verified_at")
  verifiedBy          String?                    @map("verified_by")
  customerHint        String?                    @map("customer_hint")
  finalClassification String?                    @map("final_classification")
  isTaxable           Boolean                    @default(true) @map("is_taxable")
  classificationId    String?                    @map("classification_id")
  invoice             Invoice?
  business            Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  classification      TransactionClassification? @relation(fields: [classificationId], references: [id], onDelete: SetNull)

  @@unique([businessId, source, referenceId], name: "unique_sales_reference")
  @@index([businessId, transactionDate(sort: Desc)])
  @@index([referenceId])
  @@index([source])
  @@index([businessId, needsVerification], map: "idx_sales_needs_verification")
  @@index([classificationId])
  @@map("sales_transactions")
}

/// Expenses - business expenditure tracking
model Expense {
  id           String          @id @default(uuid())
  businessId   String          @map("business_id")
  category     ExpenseCategory
  description  String
  amount       Decimal         @db.Decimal(15, 2)
  expenseDate  DateTime        @map("expense_date") @db.Date
  receiptUrl   String?         @map("receipt_url")
  isDeductible Boolean         @default(true) @map("is_deductible")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  createdBy    String?         @map("created_by")
  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, expenseDate(sort: Desc)])
  @@index([category])
  @@index([businessId, isDeductible])
  @@map("expenses")
}

/// Monthly tax reports - calculated tax obligations
model MonthlyTaxReport {
  id            String        @id @default(uuid())
  businessId    String        @map("business_id")
  taxMonth      DateTime      @map("tax_month") @db.Date
  totalSales    Decimal       @default(0) @map("total_sales") @db.Decimal(15, 2)
  totalExpenses Decimal       @default(0) @map("total_expenses") @db.Decimal(15, 2)
  grossProfit   Decimal       @default(0) @map("gross_profit") @db.Decimal(15, 2)
  taxRate       Decimal       @default(7.5) @map("tax_rate") @db.Decimal(5, 2)
  taxPayable    Decimal       @default(0) @map("tax_payable") @db.Decimal(15, 2)
  profitMargin  Decimal?      @map("profit_margin") @db.Decimal(5, 2)
  paymentStatus PaymentStatus @default(pending) @map("payment_status")
  isFinalized   Boolean       @default(false) @map("is_finalized")
  isLocked      Boolean       @default(false) @map("is_locked")
  lockedAt      DateTime?     @map("locked_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payments      TaxPayment[]
  statement     TaxStatement?

  @@unique([businessId, taxMonth])
  @@index([businessId, taxMonth(sort: Desc)])
  @@index([paymentStatus])
  @@map("monthly_tax_reports")
}

/// Tax payments - payment transactions to FIRS
model TaxPayment {
  id                   String           @id @default(uuid())
  businessId           String           @map("business_id")
  taxReportId          String           @map("tax_report_id")
  amountPaid           Decimal          @map("amount_paid") @db.Decimal(15, 2)
  paymentMethod        PaymentMethod    @map("payment_method")
  transactionReference String           @unique @map("transaction_reference")
  gatewayResponse      Json?            @map("gateway_response")
  paymentStatus        PaymentStatus    @default(pending) @map("payment_status")
  paymentDate          DateTime?        @map("payment_date")
  firsRemittanceRef    String?          @map("firs_remittance_ref")
  firsReceiptUrl       String?          @map("firs_receipt_url")
  remittanceStatus     RemittanceStatus @default(collected) @map("remittance_status")
  remittanceId         String?          @map("remittance_id")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  business             Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  taxReport            MonthlyTaxReport @relation(fields: [taxReportId], references: [id], onDelete: Cascade)
  remittance           FirsRemittance?  @relation(fields: [remittanceId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([transactionReference])
  @@index([paymentStatus])
  @@index([remittanceStatus])
  @@map("tax_payments")
}

/// FIRS remittance batches - groups collected tax payments forwarded to FIRS as a lump sum.
/// FIRS has no API yet, so remittance is recorded manually by an admin (transport='manual').
model FirsRemittance {
  id             String           @id @default(uuid())
  status         RemittanceStatus @default(remitting)
  totalAmount    Decimal          @default(0) @map("total_amount") @db.Decimal(15, 2)
  paymentCount   Int              @default(0) @map("payment_count")
  firsReference  String?          @map("firs_reference")
  firsReceiptUrl String?          @map("firs_receipt_url")
  transport      String           @default("manual")
  note           String?
  createdBy      String?          @map("created_by")
  remittedAt     DateTime?        @map("remitted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  payments       TaxPayment[]

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("firs_remittances")
}

/// Tax statements - generated PDF documents
model TaxStatement {
  id           String           @id @default(uuid())
  businessId   String           @map("business_id")
  taxReportId  String           @unique @map("tax_report_id")
  pdfUrl       String           @map("pdf_url")
  pdfSizeBytes Int?             @map("pdf_size_bytes")
  generatedAt  DateTime         @default(now()) @map("generated_at")
  expiresAt    DateTime?        @map("expires_at")
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  taxReport    MonthlyTaxReport @relation(fields: [taxReportId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("tax_statements")
}

/// Audit logs - immutable security and compliance trail
model AuditLog {
  id           String    @id @default(uuid())
  userId       String?   @map("user_id")
  businessId   String?   @map("business_id")
  action       String
  resourceType String?   @map("resource_type")
  resourceId   String?   @map("resource_id")
  oldData      Json?     @map("old_data")
  newData      Json?     @map("new_data")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")
  business     Business? @relation(fields: [businessId], references: [id])
  user         User?     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([businessId, createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}

/// Customers - client master data per business, reused across invoices
model Customer {
  id         String    @id @default(uuid())
  businessId String    @map("business_id")
  name       String
  email      String?
  phone      String?
  address    String?
  city       String?
  state      String?
  taxId      String?   @map("tax_id")
  notes      String?
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoices   Invoice[]

  @@index([businessId, name])
  @@index([businessId, isActive])
  @@map("customers")
}

/// Invoices - pre-sale billing documents sent to customers
/// Lifecycle: draft -> sent -> paid (auto-creates SalesTransaction) | cancelled | overdue
model Invoice {
  id              String                @id @default(uuid())
  businessId      String                @map("business_id")
  customerId      String?               @map("customer_id")
  invoiceNumber   String                @map("invoice_number")
  status          InvoiceStatus         @default(draft)
  issueDate       DateTime              @map("issue_date") @db.Date
  dueDate         DateTime              @map("due_date") @db.Date
  sentAt          DateTime?             @map("sent_at")
  paidAt          DateTime?             @map("paid_at")
  customerName    String                @map("customer_name")
  customerEmail   String?               @map("customer_email")
  customerPhone   String?               @map("customer_phone")
  customerAddress String?               @map("customer_address")
  customerTaxId   String?               @map("customer_tax_id")
  subtotal        Decimal               @default(0) @db.Decimal(15, 2)
  vatRate         Decimal               @default(7.5) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount       Decimal               @default(0) @map("vat_amount") @db.Decimal(15, 2)
  discount        Decimal               @default(0) @db.Decimal(15, 2)
  total           Decimal               @default(0) @db.Decimal(15, 2)
  currency        String                @default("NGN")
  notes           String?
  paymentTerms    String?               @map("payment_terms")
  pdfUrl          String?               @map("pdf_url")
  linkedSaleId    String?               @unique @map("linked_sale_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  createdBy       String?               @map("created_by")
  /// Channel through which the customer settled — captured at mark-paid time.
  /// Null for non-paid invoices.
  paymentMethod   InvoicePaymentMethod? @map("payment_method")
  shareToken      String?               @unique @map("share_token")
  lines           InvoiceLine[]
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer?             @relation(fields: [customerId], references: [id])
  linkedSale      SalesTransaction?     @relation(fields: [linkedSaleId], references: [id])

  @@unique([businessId, invoiceNumber])
  @@index([businessId, issueDate(sort: Desc)])
  @@index([businessId, createdAt(sort: Desc)])
  @@index([businessId, status])
  @@index([customerId])
  @@index([dueDate])
  @@map("invoices")
}

/// Invoice line items - itemized billing rows on an invoice
model InvoiceLine {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(15, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(15, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
  @@map("invoice_lines")
}

model Reminder {
  id            String    @id @default(uuid())
  businessId    String    @map("business_id")
  reminderType  String    @map("reminder_type")
  scheduledDate DateTime  @map("scheduled_date") @db.Date
  isSent        Boolean   @default(false) @map("is_sent")
  sentAt        DateTime? @map("sent_at")
  message       String?
  createdAt     DateTime  @default(now()) @map("created_at")
  referenceType String?   @map("reference_type")
  referenceId   String?   @map("reference_id")
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([scheduledDate, isSent])
  @@index([businessId])
  @@index([businessId, referenceType, referenceId])
  @@map("reminders")
}

enum UserRole {
  user
  admin
}

enum PaymentMethod {
  wallet
  bank_transfer
  card
  paycode
  ussd
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
}

enum RemittanceStatus {
  collected
  remitting
  remitted
}

enum SalesSource {
  bank_transfer
  paycode
  pos
  online_store
  manual
  cash
  invoice
}

enum TransactionStatus {
  confirmed
  pending
  reversed
  disputed
}

enum ExpenseCategory {
  rent
  inventory
  salary
  utility
  fuel
  logistics
  marketing
  other
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
  cancelled
}

/// How a customer paid an invoice. Captured at mark-paid time, not at create.
/// Distinct from `PaymentMethod` (which models tax remittance via Paystack) —
/// invoice collections happen across far more channels (cash, POS terminals,
/// cheques, mobile money) than the gateway-bound tax flow.
enum InvoicePaymentMethod {
  cash
  bank_transfer
  pos
  card
  mobile_money
  cheque
  online
  other
}

enum TransactionCategory {
  revenue
  capital
  loan
  transfer
  refund
  grant
  gift
  investment
  tax_refund
  insurance
  asset_sale
  other
}

enum TaxTreatment {
  taxable
  non_taxable
  review_required
}

/// Audit log of every inbound Paystack webhook. Rows are written BEFORE
/// signature verification so even rejected/forged events are recorded.
/// Backs replay-prevention (5-min signature dedup) in payment.service.ts.
/// Matches migration 20260610144954_add_webhook_event_logging.
model PaystackWebhookEvent {
  id          String    @id @default(uuid())
  event       String
  reference   String?
  signature   String
  rawBody     String    @map("raw_body")
  status      String    @default("received")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@index([reference])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([signature, createdAt])
  @@map("paystack_webhook_events")
}

/// Cached copy of Paystack `GET /bank?country=nigeria`. Backs the
/// BVN / bank-account validation dropdown + Option A settlement onboarding.
/// Refreshed lazily (24h TTL) in bank.service.ts. Matches migration
/// 20260531120000_add_bank_cache.
model Bank {
  id            String   @id @default(uuid())
  code          String
  name          String
  slug          String   @unique
  longCode      String?  @map("long_code")
  country       String   @default("nigeria")
  currency      String   @default("NGN")
  type          String?
  active        Boolean  @default(true)
  lastFetchedAt DateTime @default(now()) @map("last_fetched_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([country, active])
  @@index([code])
  @@map("banks")
}
